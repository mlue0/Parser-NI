# Базовый URL API (без завершающего слэша)
API_URL=https://example.com/api

# Учётные данные для авторизации (опционально, приоритет имеет keyring)
API_LOGIN=your_login
API_PASSWORD=your_password

# Опциональный статический токен (если login не используется)
API_TOKEN=

# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
